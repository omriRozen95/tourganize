{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check:*)",
      "Bash(./scripts/check:*)",
      "Bash(pytest:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(mypy:*)",
      "Bash(.venv/bin/mypy:*)",
      "Bash(lint-imports)",
      "Bash(.venv/bin/lint-imports)",
      "Bash(tourganize:*)",
      "Bash(.venv/bin/tourganize:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed -n:*)"
    ]
  }
